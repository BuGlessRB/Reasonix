<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for Studio. Notarization requires the hardened
  runtime, and under it WebKit's JavaScript JIT is refused unless it is granted
  here — the window would render nothing but a blank page. Nothing else is
  loosened: this build is not sandboxed, so it needs no network or file
  entitlement to reach what the user already gave it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
