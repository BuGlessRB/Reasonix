<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for Studio. Notarization requires the hardened
  runtime, and under it WebKit's JavaScript JIT is refused unless it is granted
  here — the window would render nothing but a blank page. No network or file
  entitlement: this build is not sandboxed, so it needs none to reach what the
  user already gave it.

  Library validation is disabled to match the desktop line, whose set is the
  only one in this repository a signed Wails build has ever launched under. It
  is the one entitlement whose absence neither codesign nor notarization
  reports — it surfaces on a real Mac at launch, and this line had never
  produced a signed build to find out on.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
